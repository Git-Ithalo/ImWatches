<%- include('partials/header', { pageTitle: store.storeName }) %>

<section class="store-header">
  <div class="container">
    <span class="eyebrow badge-plan">Loja parceira IM Watches</span>
    <h1><%= store.storeName %></h1>
    <p style="max-width:60ch; color:#e7e3d5;"><%= store.description || 'Loja parceira dentro da plataforma IM Watches.' %></p>
    <% if (store.whatsapp) { %>
      <a href="https://wa.me/55<%= store.whatsapp.replace(/\D/g,'') %>" target="_blank" rel="noopener" class="btn btn-brass whatsapp-btn">Falar no WhatsApp</a>
    <% } %>
  </div>
</section>

<div class="container" style="padding:50px 32px 90px;">
  <div class="section-head">
    <h2>Catálogo de <%= store.storeName %></h2>
    <span class="small muted"><%= store.watches.length %> peça<%= store.watches.length===1 ? '' : 's' %></span>
  </div>

  <% if (store.watches.length === 0) { %>
    <div class="empty-state">Esta loja ainda não cadastrou relógios no catálogo.</div>
  <% } else { %>
    <div class="grid-products">
      <% store.watches.forEach(w => { %>
        <div class="card-watch">
          <div class="thumb">
            <div class="card-tags"><span class="tag tag-pronta"><%= w.condition %></span></div>
            <%- include('partials/watch-svg') %>
          </div>
          <div class="brand"><%= w.brand %></div>
          <h3><%= w.model %></h3>
          <div class="ref"><% if (w.ref) { %>Ref. <%= w.ref %><% } %></div>
          <div class="price">R$ <%= Number(w.price).toLocaleString('pt-BR', {minimumFractionDigits:2}) %></div>
          <% if (w.description) { %><p class="small muted" style="margin-top:8px;"><%= w.description %></p><% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>

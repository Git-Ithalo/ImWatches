<%- include('partials/header', { pageTitle: 'Início' }) %>

<section class="hero" style="padding:0;">
  <svg class="hero-watch" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
    <circle cx="300" cy="300" r="260" fill="none" stroke="var(--ink)" stroke-width="6"/>
    <circle cx="300" cy="300" r="205" fill="var(--white)" stroke="var(--ink)" stroke-width="3"/>
    <circle cx="300" cy="300" r="205" fill="none" stroke="var(--brass)" stroke-width="1" stroke-dasharray="1 9"/>
    <% for(let i=0;i<12;i++){ const a=i*30*Math.PI/180; const x1=300+185*Math.sin(a), y1=300-185*Math.cos(a), x2=300+198*Math.sin(a), y2=300-198*Math.cos(a); %>
      <line x1="<%=x1%>" y1="<%=y1%>" x2="<%=x2%>" y2="<%=y2%>" stroke="var(--ink)" stroke-width="<%= i%3===0 ? 4 : 2 %>"/>
    <% } %>
    <text x="300" y="205" text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="30" fill="var(--ink)">IM</text>
    <text x="300" y="235" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="16" fill="var(--forest)">Watches</text>
    <line x1="300" y1="300" x2="300" y2="175" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
    <line x1="300" y1="300" x2="380" y2="330" stroke="var(--ink)" stroke-width="7" stroke-linecap="round"/>
    <circle cx="300" cy="300" r="8" fill="var(--brass)"/>
    <rect x="284" y="20" width="32" height="14" rx="2" fill="none" stroke="var(--ink)" stroke-width="4"/>
    <rect x="284" y="566" width="32" height="14" rx="2" fill="none" stroke="var(--ink)" stroke-width="4"/>
    <rect x="555" y="270" width="26" height="60" rx="4" fill="none" stroke="var(--ink)" stroke-width="4"/>
  </svg>
  <div class="hero-inner">
    <div class="hero-content">
      <span class="eyebrow">Curadoria de alta relojoaria</span>
      <h1>IM WATCHES</h1>
      <div class="hero-lede">Ajudo você a montar sua coleção.</div>
      <p>Relógios novos e seminovos, selecionados com curadoria e procedência — Rolex, Seiko, Orient, Technos e outras marcas de referência, com envio para todo o Brasil.</p>
      <div class="hero-actions">
        <a href="/pronta-entrega" class="btn btn-primary">Ver pronta entrega</a>
        <a href="/marcas" class="btn btn-outline">Conheça as marcas</a>
      </div>
      <div class="hero-actions hero-actions-row2">
        <a href="/planos" class="btn btn-brass">Vender meus relógios na IM Watches →</a>
      </div>
    </div>
  </div>
</section>

<div class="trust-strip">
  <div class="trust-grid">
    <div class="trust-item"><div class="icon">✓</div><h4>100% originais</h4><p>Peças selecionadas com procedência</p></div>
    <div class="trust-item"><div class="icon">◆</div><h4>Curadoria especializada</h4><p>Seleção pensada para cada perfil</p></div>
    <div class="trust-item"><div class="icon">⟡</div><h4>Envio seguro</h4><p>Entrega protegida para todo o Brasil</p></div>
    <div class="trust-item"><div class="icon">♥</div><h4>Atendimento pessoal</h4><p>Fale direto com um especialista</p></div>
    <div class="trust-item"><div class="icon">⌘</div><h4>Compra segura</h4><p>Ambiente e pagamento protegidos</p></div>
  </div>
</div>

<section>
  <div class="container">
    <div class="section-head">
      <div>
        <h2>Novidades</h2>
        <p class="muted">As últimas peças que chegaram à IM Watches</p>
      </div>
      <a href="/pronta-entrega" class="see-all">Ver todos</a>
    </div>
    <div class="grid-products">
      <% novidades.forEach(w => { %>
        <%- include('partials/watch-card', { w }) %>
      <% }) %>
    </div>
  </div>
</section>

<section style="background:var(--white); border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>Marcas que trabalhamos</h2>
        <p class="muted">De relojoaria suíça de alta gama a marcas japonesas e nacionais acessíveis</p>
      </div>
      <a href="/marcas" class="see-all">Ver todas as marcas</a>
    </div>
    <div class="grid-products" style="grid-template-columns:repeat(6,1fr);">
      <% brands.forEach(b => { %>
        <a href="/marcas/<%= b.slug %>" class="center" style="padding:20px 6px; border:1px solid var(--line); background:var(--ivory);">
          <div class="display" style="font-size:1.3rem;"><%= b.name %></div>
          <div class="small muted"><%= b.country %></div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section>
  <div class="container two-col">
    <div>
      <span class="eyebrow">Para lojistas e colecionadores</span>
      <h2>Tem relógios para vender? Monte sua loja dentro da IM Watches.</h2>
      <p>Assine um dos nossos planos, cadastre seu catálogo em minutos e ganhe uma vitrine própria — com o mesmo padrão de curadoria e confiança que construímos aqui.</p>
      <a href="/planos" class="btn btn-primary">Conhecer os planos</a>
    </div>
    <div class="highlight-box">
      "Consegui listar meu estoque em uma tarde e já recebi as primeiras mensagens pelo WhatsApp na primeira semana." — depoimento ilustrativo de um lojista parceiro
    </div>
  </div>
</section>

<%- include('partials/footer') %>
